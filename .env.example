# Learnova AI — Environment Variables Configuration
# Copy this file to .env and configure your keys

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_TEMPERATURE=0.3

# Security & Rate Limiting
RATE_LIMIT_MAX=100

# Supabase / PostgreSQL (Optional: Learnova operates fully in zero-config demo mode without database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
