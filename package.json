{
  "name": "learnova-ai",
  "version": "1.0.0",
  "description": "Learnova AI — AI-Powered Learning Companion for School Students (Grades 6–12)",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node node_modules/tsx/dist/cli.mjs watch server/src/index.ts",
    "dev:client": "node node_modules/vite/bin/vite.js client",
    "build:server": "node scripts/buildServer.mjs",
    "build:client": "node node_modules/vite/bin/vite.js build client",
    "build": "node scripts/buildServer.mjs && node node_modules/vite/bin/vite.js build client",
    "start": "node server/dist/index.js",
    "test": "node node_modules/tsx/dist/cli.mjs server/src/test/apiSanity.ts",
    "test:eval": "node node_modules/tsx/dist/cli.mjs server/src/eval/runEvaluation.ts",
    "export:finetune": "node node_modules/tsx/dist/cli.mjs server/src/eval/finetuningExport.ts",
    "deploy": "node scripts/deployGhPages.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
